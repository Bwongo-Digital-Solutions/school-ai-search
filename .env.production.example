APP_PORT=8787
POSTGRES_DB=school_ai_search
POSTGRES_USER=schoolapp
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://schoolapp:change-me@db:5432/school_ai_search
SCHOOL_NAME=eSchool
SCHOOL_TAGLINE=Academic Excellence and Character
# Leave unset to encode the bare student number in ID card QR codes.
# Set it to encode <base>/<student number>, so a phone camera offers to open a link.
# ID_CARD_QR_BASE_URL=https://school.example/students
SCHOOL_ADDRESS=P.O. Box 123, Kampala, Uganda

# --- Product footer / document version stamp ---
# BUILD_NUMBER is stamped on the app footer and PDF footers; falls back to the git short hash.
# BUILD_NUMBER=2026.08.19
DEVELOPER_CONTACTS=e-School · support@eschool.ink

# ---------------------------------------------------------------------------
# Sessions and platform access — SET BOTH OF THESE IN PRODUCTION
# ---------------------------------------------------------------------------
# Signs every session cookie. Unset, the app generates a key at startup instead: everyone is signed
# out on each restart, and sessions do not work at all across more than one replica.
#   openssl rand -hex 32
SESSION_SECRET=

# The operator's credential for the /owner console — listing, creating and suspending schools. It is
# sent as `Authorization: Bearer <token>` and is never stored in any school's database. Unset means
# platform administration is refused outright, so no school can be created.
#   openssl rand -hex 32
PLATFORM_OWNER_TOKEN=

# Encrypts each school's own AI provider keys at rest, so a database dump does not hand them over.
# Without it a school simply cannot store one — it is told why, and keeps using the platform's keys.
#   openssl rand -hex 32
SECRETS_KEY=

# The root domain. Decides which origins may call the API cross-origin (only https://*.<root>), and
# builds the link in a school's activation email.
TENANT_ROOT_DOMAIN=eschool.ink

# Extra origins allowed cross-origin, comma-separated. Only needed for a separately hosted frontend.
# CORS_EXTRA_ORIGINS=https://console.example

# Local testing only. On, an X-Tenant header overrides the Host and chooses the school — which in
# production would let any page on the internet name whichever school it wanted. Leave it off.
# ALLOW_TENANT_HEADER=true

# Where the app publishes its port on the host. Loopback by default because the reverse proxy is the
# way in; set 0.0.0.0 only if you are running without one.
# APP_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# TLS / reverse proxy  (docker compose --profile proxy-nginx | proxy-caddy)
# ---------------------------------------------------------------------------
# Every school is a subdomain, so this needs a WILDCARD certificate for *.eschool.ink — and a
# wildcard cannot be issued over HTTP-01, only DNS-01.
#
#   proxy-nginx: you obtain it (certbot --dns-<provider>) and drop fullchain.pem + privkey.pem in
#                deploy/nginx/certs/. See deploy/nginx/docker.conf.
#   proxy-caddy: Caddy obtains and renews it itself, given a DNS API token.
#
# ACME_EMAIL=admin@eschool.ink
# CLOUDFLARE_API_TOKEN=change-me

# --- Multi-tenant (optional) ---
# Leave unset for a single school (default). To host several schools from one deployment, list
# them here; the subdomain of each request's Host header selects the tenant's isolated database.
# Each database is created empty and provisioned automatically on first use.
# TENANTS=[{"id":"kampala-high","url":"postgres://schoolapp:change-me@db:5432/kampala_high"},{"id":"gulu-ss","url":"postgres://schoolapp:change-me@db:5432/gulu_ss"}]
# Requires wildcard DNS (*.your-domain) and a wildcard TLS certificate.

# --- Self-service provisioning (optional; pay -> auto-provision) ---
# The control-plane database holding the tenant registry + subscription payments.
# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset to use the Postgres container in docker-compose.yml.
#
# To run against your own server instead — a managed Postgres, one on this host, or one on another
# machine — set it here and choose "external" in containers.sh (option 17). That stops the bundled
# container from starting at all; nothing else changes, because the app has only ever needed a
# connection string.
#
#   DATABASE_URL=postgres://schoolapp:secret@db.example.org:5432/school_ai_search
#   DATABASE_SSL=true
#
# For Postgres on this host rather than in Docker, use host.docker.internal:
#   DATABASE_URL=postgres://schoolapp:secret@host.docker.internal:5432/school_ai_search
#
# DATABASE_SSL_REJECT_UNAUTHORIZED=false only for a server presenting a self-signed certificate on
# a network you trust. It disables the check that the certificate belongs to the host you asked for.
# DATABASE_URL=
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Where database backups are written inside the container. Mounted as a named volume, so they
# survive the container being replaced. Backups hold every student record, every password hash and
# the MCP tokens that are stored in plaintext — treat the volume accordingly.
# BACKUP_DIR=/var/backups/eschool

# Runs the unattended backups a school schedules under School data -> Backups. Off unless this is
# set, so no test run, CLI script or one-off container quietly starts dumping databases. Set it on
# the long-running app container and nowhere else: two processes with it on would each take the
# day's backup, and each would think it was the one that had.
# BACKUP_SCHEDULER=true

# CONTROL_DATABASE_URL=postgres://schoolapp:change-me@db:5432/eschool_control
# An admin role WITH CREATEDB, used only to run CREATE DATABASE for each new school.
# PROVISION_ADMIN_DATABASE_URL=postgres://provisioner:change-me@db:5432/postgres
# How the app connects to each tenant db; {db} is replaced with the generated database name.
# TENANT_DB_URL_TEMPLATE=postgres://schoolapp:change-me@db:5432/{db}
# TENANT_DB_PREFIX=school_
# Subscription pricing + term. Signup is refused until SUBSCRIPTION_AMOUNT is set (> 0).
# SUBSCRIPTION_AMOUNT=500000
# SUBSCRIPTION_CURRENCY=UGX
# SUBSCRIPTION_PERIOD_DAYS=120
# SUBSCRIPTION_GRACE_DAYS=14
# Signed payment webhooks: providers must send x-webhook-signature = HMAC-SHA256(rawBody, secret).
# Leave unset in mock/dev to disable verification.
# PAYMENT_WEBHOOK_SECRET=change-me-long-random
# The root domain for the public signup page (schools get <subdomain>.<root>). Frontend build-time,
# and only a fallback: the signup page prefers the domain the browser is actually on.
# VITE_TENANT_ROOT_DOMAIN=eschool.ink

# --- Activation email (optional; "your school is ready") ---
# EMAIL_MODE=http                 # 'mock' (default, no send) or 'http'
# EMAIL_API_URL=https://api.resend.com/emails
# EMAIL_API_KEY=change-me
# EMAIL_FROM=e-School <no-reply@eschool.ink>
# TENANT_ROOT_DOMAIN=eschool.ink  # used to build the school's link in the email

# ---------------------------------------------------------------------------
# AI models
# ---------------------------------------------------------------------------
# Which model is selected by default. Falls back to the keyless local rules engine.
AI_DEFAULT_MODEL_ID=local-rules

# Add models to the built-in catalogue WITHOUT restating it. An entry whose `id` matches a built-in
# replaces just that one. This is the easy way to offer, say, a local Ollama model and an Ollama
# cloud model side by side.
#
# AI_EXTRA_MODELS=[{"id":"ollama-cloud","label":"Ollama Cloud (gpt-oss 120B)","provider":"ollama","model":"gpt-oss:120b-cloud","type":"commercial","description":"Runs on Ollama Cloud."}]

# Replaces the catalogue outright. Prefer AI_EXTRA_MODELS unless you really want only your list —
# setting this drops Local Rules and every provider you do not restate.
# AI_MODEL_CATALOG=[...]

# Ollama serves local and cloud models through the same endpoint. Run `ollama signin` once, then
# pull a cloud model (`ollama pull gpt-oss:120b-cloud`) and add it via AI_EXTRA_MODELS above.
# From Docker use host.docker.internal; from the host use 127.0.0.1.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Provider keys. A provider with no key shows as "Needs key" in the model picker rather than failing.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Global search (Meilisearch) — optional
# ---------------------------------------------------------------------------
# Unset means search still works, falling back to a basic student-name query.
# Start it with: docker compose --profile search up -d
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# MCP server — lets LibreChat, Claude Desktop or Claude Code use this school's data
# ---------------------------------------------------------------------------
# Unset DISABLES the MCP server rather than opening it. Each token maps to a role, so a teacher's
# client sees only teacher tools. Treat these like passwords.
# MCP_SERVER_TOKENS={"replace-with-a-long-random-admin-token":"admin","replace-with-a-long-random-teacher-token":"teacher"}

# The token LibreChat presents back to this app (must be one of the above).
# SCHOOLBOT_MCP_TOKEN=replace-with-a-long-random-teacher-token

# ---------------------------------------------------------------------------
# Bundled systems (Moodle, Odoo, ERPNext, Dolibarr) — optional
# ---------------------------------------------------------------------------
# Unset means the school connects systems it already runs, which is the common case. These start
# one alongside the app instead, on the shared eschool_net network:
#
#   ./containers.sh                                     # option 18, or:
#   docker compose -f deploy/integrations/moodle.yml -p school-ai-search-moodle up -d
#
# Each stack brings its own database and volumes. ERPNext is seven containers and needs a couple of
# gigabytes of memory; Dolibarr is two. Change every password below before starting one.
#
# Two addresses go into Settings -> Integrations, and they are not the same:
#   Address           what the browser opens   https://moodle.yourschool.ac.ug
#   Internal address  what the server calls    http://moodle:8080
#
# MOODLE_PORT=8080
# MOODLE_ADMIN_PASSWORD=change-me-before-you-use-this
# MOODLE_DB_PASSWORD=change-me
# ODOO_PORT=8069
# ODOO_DB_PASSWORD=change-me
# ERPNEXT_PORT=8082
# ERPNEXT_SITE=erp.localhost
# ERPNEXT_ADMIN_PASSWORD=change-me-before-you-use-this
# ERPNEXT_DB_ROOT_PASSWORD=change-me
# DOLIBARR_PORT=8081
# DOLIBARR_ADMIN_PASSWORD=change-me-before-you-use-this
# DOLIBARR_DB_PASSWORD=change-me
