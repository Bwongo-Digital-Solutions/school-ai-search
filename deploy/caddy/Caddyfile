# Caddy in front of eschool.ink, for people who would rather not manage a certificate.
#
#   docker compose --profile proxy-caddy up -d
#
# Caddy obtains and renews a wildcard certificate for *.eschool.ink by itself. A wildcard can only
# be issued over a DNS-01 challenge, which means Caddy needs an API token for the domain's DNS —
# CLOUDFLARE_API_TOKEN below. The stock caddy image contains no DNS providers, so the compose
# service builds deploy/caddy/Dockerfile, which adds the Cloudflare one.
#
# If you would rather issue the certificate yourself with certbot, use the nginx profile instead.
#
# There is deliberately no global `email` option here. Caddy's Caddyfile has no conditionals, so
# `email {$ACME_EMAIL}` with the variable unset expands to a bare `email` with no argument, and
# Caddy refuses to start: "wrong argument count or unexpected line ending after 'email'". An email
# address only buys expiry notices from the CA, so it is not worth a crash loop. To add one, put a
# literal address here rather than a placeholder:
#
#   {
#   	email you@example.com
#   }

{$TENANT_ROOT_DOMAIN:eschool.ink}, *.{$TENANT_ROOT_DOMAIN:eschool.ink} {
	# A wildcard can only be issued over DNS-01, so Caddy needs a token that may edit this zone's
	# DNS. The provider name here must match the plugin built into deploy/caddy/Dockerfile.
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}

	encode gzip

	# Caddy preserves the Host header by default, which is what chooses the school, and sets
	# X-Forwarded-Proto and X-Forwarded-For — so the app knows it was reached over TLS and marks
	# the session cookie Secure. Nothing extra is needed for either.
	reverse_proxy app:8787 {
		# A local model writing a paper can take minutes; the default would cut it off.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
		# Never forwarded from a client: the app honours X-Tenant only when ALLOW_TENANT_HEADER is
		# on, and stripping it here means a misconfiguration cannot become a data leak.
		header_up -X-Tenant
	}

	# Security headers (HSTS, nosniff, X-Frame-Options, Referrer-Policy) come from the app on every
	# response, so they are deliberately not repeated here.
}
